# Copy to .env and fill in your LLM key. Everything else works as-is with the
# broker that docker-compose starts for you.
#
#   cp .env.sample .env

# ---------------------------------------------------------------------------
# Solace broker
# ---------------------------------------------------------------------------
# These point at the bundled broker container. A fresh PubSub+ Standard broker
# accepts any username/password on the "default" VPN, so these values need no
# broker-side setup.
#
# The Go Agent Mesh runtime and the dashboard backend need native SMF (tcp://);
# the browser connects separately over ws://localhost:47008 using the defaults
# in the dashboard's Solace Connection panel.
SOLACE_BROKER_URL=tcp://broker:55555
SOLACE_BROKER_USERNAME=default
SOLACE_BROKER_PASSWORD=default
SOLACE_BROKER_VPN=default

# ---------------------------------------------------------------------------
# LLM - the only external credential this demo needs
# ---------------------------------------------------------------------------
# Agent Mesh registers its `general` and `planning` model aliases from these
# variables, and solace-agent-mesh/models/general.yaml keeps them in sync on
# every `sam config apply`.
#
# Any OpenAI-compatible endpoint works. Model names use LiteLLM's
# "<protocol>/<model>" form, so keep the openai/ prefix for OpenAI-compatible
# gateways even when the underlying model is not an OpenAI one.
#
# Examples:
#   OpenAI direct     LLM_SERVICE_ENDPOINT=https://api.openai.com/v1
#                     LLM_SERVICE_GENERAL_MODEL_NAME=openai/gpt-4o
#   Anthropic direct  LLM_SERVICE_ENDPOINT=https://api.anthropic.com/v1
#                     LLM_SERVICE_GENERAL_MODEL_NAME=anthropic/claude-sonnet-4-5
#   LiteLLM proxy     LLM_SERVICE_ENDPOINT=https://your-litellm-host/
#                     LLM_SERVICE_GENERAL_MODEL_NAME=openai/<model-as-named-by-the-proxy>
LLM_SERVICE_ENDPOINT=https://api.openai.com/v1
LLM_SERVICE_API_KEY=your_llm_api_key
LLM_SERVICE_GENERAL_MODEL_NAME=openai/gpt-4o
LLM_SERVICE_PLANNING_MODEL_NAME=openai/gpt-4o

# The trading-signal-agent and market-research-agent are bound to this
# cheaper "cheap" model alias instead of `general` (see
# solace-agent-mesh/models/cheap.yaml) - they run on every tweet /
# research click, so a long demo session is much cheaper on a small/fast
# model than on the same tier as the chat agents. Pick your provider's
# cheapest capable tier, e.g. gpt-4o-mini, claude haiku, gemini flash.
LLM_SERVICE_CHEAP_MODEL_NAME=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Backlog guardrail
# ---------------------------------------------------------------------------
# Message TTL (seconds) the queue-guardrail service sets on the
# tweet_to_signal queue via SEMP, so a long-running demo can't quietly build
# an unbounded backlog if the agent ever falls behind the tweet rate - a
# stale tweet is dropped instead of piling up. 300s (5 min) is generous next
# to normal processing time, tight next to "hours left running unattended."
# TWEET_QUEUE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Agent Mesh image tag, if you loaded a version other than the compose default.
# SAM_VERSION=2.275.10

# Signing key for Agent Mesh web sessions. Fine to leave alone locally; set a
# real value for anything shared.
# SAM_SESSION_SECRET=change-me-for-anything-shared

# Only needed if you enable live web research on the market-research-agent
# (see README "Optional: live web research"). Without these the agent still
# works - it reasons over the live event-mesh context instead of searching.
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_CSE_ID=
